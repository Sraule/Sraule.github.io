---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Home from '../components/Home.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CimoPlaceholder from '../components/CimoPlaceholder.astro';
import FigureViewer from '../components/FigureViewer.astro';
import { profile } from '../data/profile';
import Skills from '../components/Skills.astro';
import { projects } from '../data/projects';
---
<Layout>
  <Header/>
  <main id="main">
    <Home/>

    <section id="research" class="research-section shell section">
      <div class="section-heading"><div class="section-label"><span>01 — Research</span><h2>Research projects</h2></div><p>Causal video prediction, multimodal understanding, and weather evolution.</p></div>
      <div class="projects-grid">{projects.map((project,index) => project.id === 'cimo' ? <CimoPlaceholder project={project} index={index}/> : <ProjectCard project={project} index={index}/>)}</div>
      <FigureViewer/>
    </section>

    <Skills/>

    <section id="contact" class="shell contact-section">
      <div><p class="eyebrow">03 — Contact</p><h2>Let’s exchange ideas.</h2><p>Interested in multimodal learning, vision, or causal reasoning?<br/> I’d be glad to connect.</p></div>
      <a class="contact-email" href={`mailto:${profile.email}`}><span><span class="contact-label">Say hello</span>{profile.email}</span><Icon name="external" size={30}/></a>
    </section>
  </main>
  <footer class="shell footer"><p>© {new Date().getFullYear()} {profile.name} <span lang="zh-Hans">{profile.chineseName}</span></p><p>{profile.university}</p><a href="#top">Back to top ↑</a></footer>
</Layout>
