---
import PaperFigure from './PaperFigure.astro';
import type { ProjectStudy } from '../data/projectStudies';
interface Props { study:ProjectStudy; projectId:string; }
const {study,projectId}=Astro.props;
---
<div class="project-study">
  {study.sections.map(section => <section class="study-section" aria-labelledby={`${projectId}-${section.key}`}>
    <header class="study-heading"><p class="study-label">{section.label}</p><h4 id={`${projectId}-${section.key}`}>{section.title}</h4><p>{section.intro}</p></header>
    {section.figures && <div class:list={['study-figures',{'paired':section.figures.length>1}]}>{section.figures.map(figure=><div class="figure-entry"><PaperFigure {...figure}/>{figure.description && <p class="figure-description">{figure.description}</p>}</div>)}</div>}
    {section.metrics && <dl class="study-metrics">{section.metrics.map(metric=><div><dt>{metric.label}</dt><dd>{metric.value}</dd></div>)}</dl>}
    {section.table && <div class="study-table-block"><h5>{section.table.title}</h5><div class="table-scroll" role="region" aria-label={section.table.title} tabindex="0"><table><caption>{section.table.caption}</caption><thead><tr>{section.table.columns.map(column=><th scope="col">{column}</th>)}</tr></thead><tbody>{section.table.rows.map((row,rowIndex)=><tr class:list={{'full-result':rowIndex===section.table!.rows.length-1}}>{row.map((cell,index)=>index===0?<th scope="row">{cell}</th>:<td>{cell}</td>)}</tr>)}</tbody></table></div><p class="table-note">{section.table.note}</p></div>}
    {section.points && <div class:list={['study-points',{'three':section.points.length===3}]}>{section.points.map(point=><div><h5>{point.title}</h5><p>{point.description}</p></div>)}</div>}
  </section>)}
</div>
<style>
  .study-section { margin-top:30px; padding-top:26px; border-top:1px solid var(--line); }
  .study-label { color:var(--green); font-size:11px; font-weight:600; line-height:1.5; letter-spacing:.085em; text-transform:uppercase; }
  .study-heading h4 { margin-top:8px; color:var(--ink); font-size:21px; font-weight:500; line-height:1.35; letter-spacing:-.025em; text-wrap:pretty; }
  .study-heading > p:last-child { max-width:110ch; margin-top:9px; color:var(--muted); font-size:13px; line-height:1.8; text-wrap:pretty; }
  .study-figures { display:grid; grid-template-columns:minmax(0,1fr); gap:20px; margin-top:21px; }
  .study-figures.paired { grid-template-columns:repeat(2,minmax(0,1fr)); }
  .figure-entry { min-width:0; }
  .figure-description { margin-top:10px; padding-inline:2px; color:var(--muted); font-size:12px; line-height:1.8; text-wrap:pretty; }
  .study-metrics { display:grid; grid-template-columns:repeat(auto-fit,minmax(110px,1fr)); gap:18px; margin:22px 0 0; padding:18px 20px; border-radius:12px; background:var(--soft); }
  .study-metrics > div { display:grid; align-content:start; }
  .study-metrics dt { grid-row:2; margin-top:5px; color:var(--muted); font-size:11px; line-height:1.5; }
  .study-metrics dd { grid-row:1; margin:0; color:var(--ink); font-size:27px; font-weight:500; line-height:1.25; letter-spacing:-.025em; font-variant-numeric:tabular-nums; }
  .study-points { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:18px 30px; margin-top:22px; }
  .study-points.three { grid-template-columns:repeat(3,minmax(0,1fr)); gap:24px; }
  .study-points > div { min-width:0; padding-left:13px; border-left:2px solid var(--line); }
  h5 { color:var(--ink); font-size:14px; font-weight:500; line-height:1.6; letter-spacing:-.01em; }
  .study-points p { margin-top:5px; color:var(--muted); font-size:12px; line-height:1.8; text-wrap:pretty; }
  .study-table-block { margin-top:24px; }
  .table-scroll { overflow-x:auto; margin-top:10px; border:1px solid var(--line); border-radius:12px; background:var(--soft); }
  table { width:100%; border-collapse:collapse; font-size:12px; line-height:1.6; font-variant-numeric:tabular-nums; }
  caption { padding:12px 16px 8px; text-align:left; color:var(--muted); font-size:11px; line-height:1.6; }
  th,td { padding:10px 16px; text-align:right; white-space:nowrap; border-top:1px solid var(--line); }
  th:first-child { text-align:left; }
  thead th { color:var(--subtle); font-size:11px; font-weight:400; }
  tbody th { color:var(--ink); font-weight:400; }
  tbody td { color:var(--muted); }
  .full-result th,.full-result td { color:var(--ink); font-weight:600; background:var(--active); }
  .table-note { margin-top:9px; color:var(--muted); font-size:11px; line-height:1.8; text-wrap:pretty; }
  @media(max-width:1000px) { .study-points.three { grid-template-columns:minmax(0,1fr); gap:16px; } th,td { padding-inline:12px; } }
  @media(max-width:760px) {
    .study-figures.paired { grid-template-columns:minmax(0,1fr); }
    .study-heading > p:last-child { font-size:14px; }
    .figure-description,.study-points p { font-size:13px; }
    .study-points { gap:20px; }
  }
  @media(max-width:520px) {
    .study-section { margin-top:25px; padding-top:22px; }
    .study-heading h4 { font-size:20px; }
    .study-points { grid-template-columns:minmax(0,1fr); gap:16px; }
    .study-metrics { grid-template-columns:repeat(2,minmax(0,1fr)); padding:16px; gap:18px 12px; }
    .study-metrics dd { font-size:25px; }
    table { font-size:11px; } thead th,caption,.table-note { font-size:10.5px; } th,td { padding:9px 11px; }
  }
</style>
