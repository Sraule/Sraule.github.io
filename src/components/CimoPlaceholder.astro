---
import type { Project } from '../data/projects';
interface Props { project:Project; index:number; }
const {project,index}=Astro.props;
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<article class="project-card project-detail placeholder" id="cimo" aria-labelledby="cimo-heading">
  <header class="detail-header">
    <div class="detail-topline"><span>{String(index+1).padStart(2,'0')} / {project.area}</span><span>{project.year}</span></div>
    <h3 id="cimo-heading">CIMO</h3>
    <p class="detail-subtitle">{project.title}</p>
  </header>
  <div class="placeholder-body"><p class="detail-intro">{project.description}</p><img src={`${base}/${project.image}`} alt={project.alt} width="1200" height="560" decoding="async"/></div>
</article>
<style>
  .placeholder-body { display:grid; grid-template-columns:minmax(0,1.15fr) minmax(0,1fr); gap:40px; align-items:center; margin-top:22px; }
  .placeholder-body p { margin-top:0; max-width:52ch; }
  .placeholder-body img { display:block; width:100%; height:auto; object-fit:contain; border:1px solid var(--line); }
  @media(max-width:700px) { .placeholder-body { grid-template-columns:minmax(0,1fr); gap:20px; margin-top:18px; } }
</style>
