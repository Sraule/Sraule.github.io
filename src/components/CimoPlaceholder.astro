---
import type { Project } from '../data/projects';
interface Props { project:Project; index:number; }
const {project,index}=Astro.props;
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<article class="project-card placeholder" id="cimo" aria-labelledby="cimo-heading">
  <header><span>{String(index+1).padStart(2,'0')} / {project.area}</span><span>{project.year}</span></header>
  <div class="placeholder-body"><div><h3 id="cimo-heading">CIMO</h3><p class="subtitle">{project.title}</p><p class="summary">{project.description}</p></div><img src={`${base}/${project.image}`} alt={project.alt} width="1200" height="560" decoding="async"/></div>
</article>
<style>
  .placeholder { padding:29px 32px; border-radius:22px; }
  header { display:flex; justify-content:space-between; align-items:baseline; gap:20px; color:var(--green); font-size:11px; letter-spacing:.07em; line-height:1.5; text-transform:uppercase; }
  header span:last-child { color:var(--subtle); }
  .placeholder-body { display:grid; grid-template-columns:1.15fr 1fr; gap:35px; align-items:center; margin-top:18px; }
  h3 { color:var(--ink); font-size:34px; font-weight:600; letter-spacing:-.045em; line-height:1.2; }
  .subtitle { margin-top:8px; color:var(--ink); font-size:17px; line-height:1.5; }
  .summary { margin-top:12px; max-width:60ch; color:var(--muted); font-size:14px; line-height:1.8; }
  img { width:100%; height:auto; object-fit:contain; border:1px solid var(--line); border-radius:13px; }
  @media(max-width:700px) { .placeholder { padding:23px 20px; } .placeholder-body { grid-template-columns:1fr; gap:20px; } header { font-size:10px; } h3 { font-size:31px; } }
</style>
