---
import Icon from './Icon.astro';
import { profile, education } from '../data/profile';
import { projects } from '../data/projects';
import { home } from '../data/home';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const featured = projects.filter(project => ['lemon', 'stagescope', 'cimo'].includes(project.id));
---
<section id="top" class="home-hero shell" aria-labelledby="home-name">
  <div class="home-main">
    <p class="home-eyebrow"><span lang="zh-Hans">上海交通大学</span><span aria-hidden="true"> / </span>SJTU</p>
    <div class="home-profile">
      <div class="home-portrait"><img src={`${base}/${profile.avatar}`} alt="Personal avatar selected by the researcher" width="120" height="120" fetchpriority="high" decoding="async"/></div>
      <div class="home-identity">
        <div class="home-name"><h1 id="home-name">{profile.name}</h1></div>
        <p class="home-role"><span class="home-chinese-name" lang="zh-Hans">{profile.chineseName}</span><span class="role-divider" aria-hidden="true"></span><span>{profile.role}</span></p>
      </div>
    </div>
    <div class="home-affiliation"><img class="home-university-logo" src={`${base}/${profile.universityLogo}`} alt="Shanghai Jiao Tong University emblem" width="48" height="48" decoding="async"/><div><p class="home-university">{profile.university}</p><p class="home-school">{profile.school}</p></div></div>
    <p class="home-summary" lang={home.overviewLang}>{home.overview}</p>
    <div class="home-interests" aria-label="Research interests">
      {home.interests.map(interest => <a href={interest.href} class="home-interest"><span class="interest-symbol"><Icon name={interest.icon} size={23}/></span><span>{interest.label}</span></a>)}
    </div>
    <div class="home-actions">
      <a href="#research" class="button button-primary">Explore research <Icon name="arrow" size={18}/></a>
      <a href={`mailto:${profile.email}`} class="home-email"><Icon name="mail" size={17}/><span>{profile.email}</span></a>
    </div>
    <p class="home-location"><Icon name="pin" size={14}/>{profile.location}</p>
  </div>

  <aside class="home-research" aria-labelledby="home-research-heading">
    <div class="research-heading"><h2 id="home-research-heading">Research overview</h2><a href="#research" aria-label="View research projects"><Icon name="external" size={18}/></a></div>
    <div class="home-projects">
      {featured.map((project, index) => <a href={`#${project.id}`} class={`home-project ${project.tone}`} aria-label={`Explore ${project.name}: ${home.recentWork.find(item => item.name === project.name)?.label || project.area}`}>
        <div class="project-image"><img src={`${base}/${project.thumbnail || project.image}`} alt={project.thumbnailAlt || project.alt} width="1400" height="660" decoding="async"/></div>
        <div class="project-info"><span class="project-order">0{index + 1}</span><div><h3>{project.name}</h3><p>{home.recentWork.find(item => item.name === project.name)?.label || project.area}</p></div><span class="project-arrow"><Icon name="external" size={19}/></span></div>
      </a>)}
    </div>
  </aside>

  <div id="education" class="home-education" aria-label="Education overview">
    {education.map(item => <div class="education-summary"><span class="education-symbol">{item.initials}</span><div class="education-copy"><p class="education-degree">{item.degree}</p><p class="education-school">{item.university}</p></div><span class="education-years">{item.start.match(/\d{4}/)?.[0]}–{item.end.match(/\d{4}/)?.[0]}{item.current && <small>expected</small>}</span></div>)}
  </div>
</section>


<style>
  .home-hero { display:grid; grid-template-columns:minmax(0,1.26fr) minmax(0,1fr); gap:30px 48px; padding-top:38px; }
  .home-main,.home-identity,.home-research { min-width:0; }
  .home-eyebrow { color:var(--accent); font-size:10px; font-weight:500; line-height:1.6; letter-spacing:.12em; }
  .home-eyebrow span:first-child { letter-spacing:.18em; }
  .home-eyebrow span + span { margin-inline:6px; color:var(--line); }
  .home-profile { display:flex; align-items:center; gap:21px; margin-top:24px; }
  .home-portrait { flex:0 0 82px; width:82px; height:82px; padding:3px; border:1px solid var(--line); border-radius:50%; }
  .home-portrait img { display:block; width:100%; height:100%; object-fit:cover; border-radius:inherit; clip-path:circle(45%); transform:scale(1.1); }
  .home-name h1 { font:400 clamp(40px,4.35vw,58px)/1.1 var(--font-display); letter-spacing:-.04em; }
  .home-role { display:flex; align-items:center; flex-wrap:wrap; gap:5px 10px; margin-top:13px; color:var(--muted); font-size:12px; line-height:1.65; }
  .home-chinese-name { color:var(--ink); font:400 17px/1.5 var(--font-display); letter-spacing:.1em; }
  .role-divider { width:1px; height:13px; background:var(--line); }
  .home-role > span:last-child { flex-basis:100%; }
  .role-divider { display:none; }
  .home-affiliation { display:flex; align-items:center; gap:13px; margin-top:26px; }
  .home-affiliation > div { min-width:0; }
  .home-university-logo { display:block; width:49px; height:49px; flex:0 0 49px; object-fit:contain; border-radius:50%; background:#fff; padding:2px; }
  .home-university { color:var(--accent); font-size:16px; font-weight:500; line-height:1.5; letter-spacing:-.015em; }
  .home-school { margin-top:5px; color:var(--muted); font-size:12px; line-height:1.65; }
  .home-summary { max-width:49ch; margin-top:25px; color:var(--muted); font-size:15px; line-height:1.85; text-wrap:pretty; }
  .home-summary:lang(zh) { line-height:1.95; }
  .home-interests { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:18px; margin-top:23px; }
  .home-interest { display:flex; flex-direction:column; align-items:flex-start; gap:10px; padding-top:12px; border-top:1px solid var(--line); }
  .interest-symbol { display:flex; align-items:center; color:var(--accent); }
  .interest-symbol :global(svg) { width:18px; height:18px; }
  .home-interest > span:last-child { color:var(--ink); font-size:12px; line-height:1.5; }
  .home-interest:hover > span:last-child { color:var(--accent); text-decoration:underline; text-underline-offset:4px; }
  .home-actions { display:flex; align-items:center; flex-wrap:wrap; gap:12px 22px; margin-top:25px; }
  .home-actions .button { display:inline-flex; align-items:center; gap:20px; padding:10px 15px; min-height:43px; background:var(--accent); color:var(--bg); border:1px solid var(--accent); border-radius:3px; font-size:12px; line-height:1.6; }
  .home-actions .button:hover { background:var(--ink); border-color:var(--ink); }
  .home-email { display:inline-flex; align-items:center; gap:8px; min-height:40px; color:var(--muted); font-size:12px; line-height:1.6; }
  .home-email span { overflow-wrap:anywhere; }
  .home-email:hover { color:var(--accent); }
  .home-email :global(svg) { flex-shrink:0; }
  .home-location { display:flex; align-items:center; gap:7px; margin-top:12px; color:var(--subtle); font-size:11px; }
  .home-research { align-self:start; padding-left:27px; border-left:1px solid var(--line); }
  .research-heading { display:flex; align-items:center; justify-content:space-between; gap:20px; margin-bottom:16px; }
  .research-heading h2 { font:400 23px/1.3 var(--font-display); letter-spacing:-.02em; }
  .research-heading > a { display:grid; place-items:center; width:28px; height:28px; color:var(--subtle); }
  .research-heading > a:hover { color:var(--accent); }
  .home-projects { display:grid; gap:0; }
  .home-project { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1.1fr); gap:17px; align-items:center; padding-block:16px; min-width:0; border-top:1px solid var(--line); }
  .project-image { display:flex; align-items:center; justify-content:center; min-width:0; height:111px; padding:6px; border:1px solid var(--line); background:white; }
  .project-image img { display:block; width:100%; height:100%; max-height:100%; object-fit:contain; }
  .project-info { display:grid; grid-template-columns:minmax(0,1fr) auto; gap:7px; align-items:center; }
  .project-order { grid-column:1/-1; color:var(--subtle); font:italic 11px/1.2 var(--font-display); }
  .project-info h3 { font:400 24px/1.25 var(--font-display); letter-spacing:-.025em; }
  .project-info p { margin-top:5px; color:var(--muted); font-size:11px; line-height:1.6; }
  .project-arrow { display:flex; color:var(--accent); }
  .home-project:hover h3 { color:var(--accent); }
  .home-education { grid-column:1/-1; display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:32px; padding-top:24px; border-top:1px solid var(--line); }
  .education-summary { display:flex; align-items:center; gap:14px; min-width:0; }
  .education-summary + .education-summary { border-left:1px solid var(--line); padding-left:32px; }
  .education-symbol { flex-shrink:0; color:var(--accent); font:400 15px/1.3 var(--font-display); }
  .education-copy { min-width:0; }
  .education-degree { font-size:12px; line-height:1.6; font-weight:500; }
  .education-school { margin-top:4px; color:var(--muted); font-size:11px; line-height:1.6; }
  .education-years { margin-left:auto; flex-shrink:0; color:var(--subtle); font-size:10px; line-height:1.6; text-align:right; font-variant-numeric:tabular-nums; }
  .education-years small { display:block; font-size:10px; }
  @media(max-width:1050px) {
    .home-hero { gap:27px 32px; }
    .home-profile { gap:16px; }
    .home-name h1 { font-size:43px; }
    .home-portrait { width:70px; height:70px; flex-basis:70px; }
    .home-research { padding-left:22px; }
    .home-project { gap:12px; }
    .project-info h3 { font-size:22px; }
    .project-image { height:106px; }
    .project-arrow { display:none; }
    .education-years { display:none; }
  }
  @media(max-width:800px) {
    .home-hero { grid-template-columns:minmax(0,1fr); padding-top:30px; gap:30px; }
    .home-profile { gap:20px; }
    .home-name h1 { font-size:54px; }
    .home-portrait { width:83px; height:83px; flex-basis:83px; }
    .home-role > span:last-child { flex-basis:auto; }
    .role-divider { display:block; }
    .home-summary { max-width:70ch; }
    .home-interests { gap:25px; }
    .home-interest { flex-direction:row; align-items:center; gap:10px; padding-top:13px; }
    .home-research { padding-left:0; border-left:0; }
    .home-projects { grid-template-columns:repeat(3,minmax(0,1fr)); gap:20px; }
    .home-project { grid-template-columns:minmax(0,1fr); padding-block:14px 0; gap:12px; }
    .project-image { height:120px; }
    .project-info { gap:5px; }
    .project-order { display:none; }
    .project-info p { font-size:11px; }
    .home-education { gap:24px; }
    .education-summary + .education-summary { padding-left:24px; }
  }
  @media(max-width:560px) {
    .home-hero { padding-top:27px; gap:27px; }
    .home-profile { gap:16px; margin-top:21px; }
    .home-portrait { width:65px; height:65px; flex-basis:65px; padding:2px; }
    .home-name h1 { font-size:clamp(31px,8.9vw,44px); }
    .home-role { margin-top:9px; font-size:11px; gap:4px 8px; }
    .home-role > span:last-child { flex-basis:100%; }
    .home-chinese-name { font-size:15px; }
    .role-divider { display:none; }
    .home-affiliation { margin-top:23px; gap:11px; }
    .home-university-logo { width:43px; height:43px; flex-basis:43px; }
    .home-university { font-size:14px; }
    .home-school { font-size:11px; }
    .home-summary { margin-top:22px; font-size:14px; }
    .home-interests { gap:12px; margin-top:20px; }
    .home-interest { flex-direction:column; align-items:flex-start; gap:9px; }
    .home-interest > span:last-child { font-size:11px; }
    .home-actions { gap:7px 17px; margin-top:23px; }
    .home-actions .button { gap:16px; }
    .home-email { font-size:11px; }
    .research-heading h2 { font-size:22px; }
    .research-heading { margin-bottom:0; }
    .home-projects { grid-template-columns:minmax(0,1fr); gap:0; }
    .home-project { grid-template-columns:115px minmax(0,1fr); gap:17px; padding-block:15px; }
    .project-image { height:86px; padding:5px; }
    .project-info h3 { font-size:23px; }
    .project-info p { font-size:11.5px; }
    .project-arrow { display:flex; }
    .home-education { grid-template-columns:1fr; gap:17px; padding-top:22px; }
    .education-summary { gap:13px; }
    .education-summary + .education-summary { border-left:0; padding-left:0; padding-top:17px; border-top:1px solid var(--line); }
    .education-degree { font-size:11.5px; }
    .education-years { display:block; font-size:10px; }
    .education-school { font-size:10.5px; }
  }
  @media(max-width:350px) { .home-profile { gap:12px; } .home-portrait { width:54px; height:54px; flex-basis:54px; } .home-name h1 { font-size:31px; } .education-years { display:none; } .home-project { grid-template-columns:95px minmax(0,1fr); gap:14px; } }

</style>
