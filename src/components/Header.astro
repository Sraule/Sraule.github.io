---
import Icon from './Icon.astro';
import { profile } from '../data/profile';
const links = [
  { href: '#top', label: 'Home' },
  { href: '#research', label: 'Research' },
  { href: '#skills', label: 'Skills' },
  { href: '#contact', label: 'Contact' },
];
---
<header class="site-header">
  <div class="shell header-inner">
    <a href="#top" class="brand" aria-label={`${profile.name}, back to top`}><span class="brand-mark" aria-hidden="true"><svg width="44" height="44" viewBox="0 0 44 44" fill="none"><path d="M14 27.5 22 13l8 14.5H14Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M22 13v9m-8 5.5 8-5.5 8 5.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="22" cy="11" r="4" fill="var(--surface-strong)" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="29" r="4" fill="var(--surface-strong)" stroke="currentColor" stroke-width="1.8"/><circle cx="32" cy="29" r="4" fill="var(--green)"/><circle cx="22" cy="22" r="2.5" fill="currentColor"/></svg></span></a>
    <nav aria-label="Main navigation" id="main-nav">
      <div class="nav-links">{links.map((link, index) => <a class="nav-link" href={link.href} aria-current={index === 0 ? 'location' : undefined}>{link.label}</a>)}</div>
    </nav>
    <button class="icon-button theme-toggle" type="button" aria-label="Switch to dark theme" aria-pressed="false"><span class="light-icon"><Icon name="moon"/></span><span class="dark-icon"><Icon name="sun"/></span></button>
  </div>
</header>
