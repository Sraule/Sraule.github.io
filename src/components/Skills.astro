---
import Icon from './Icon.astro';
import { skills } from '../data/profile';
---
<section id="skills" class="section shell glass-panel research-skills" aria-labelledby="skills-heading">
  <header class="skills-heading"><div class="section-label"><span>02 — Skills</span><h2 id="skills-heading">Research skills</h2></div><p>Technical experience in research implementation,<br class="desktop-break"/> model training, and empirical evaluation.</p></header>
  <div class="skills-cards">{skills.map(group => <section class="skill-card" aria-label={group.label}>
    <div class="skill-card-heading"><span class="skill-icon"><Icon name={group.icon} size={20}/></span><h3>{group.label}</h3></div>
    <ul>{group.items.map(item=><li class:list={{'sft-item':item.includes('(SFT)')}}><span class="skill-dot" aria-hidden="true"></span><span>{item}</span></li>)}</ul>
  </section>)}</div>
</section>
<style>
  .research-skills { padding:28px 30px 30px; border-radius:22px; }
  .skills-heading { display:flex; align-items:end; justify-content:space-between; gap:30px; }
  .skills-heading > p { color:var(--muted); font-size:13px; line-height:1.7; text-wrap:pretty; }
  .skills-cards { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:13px; margin-top:23px; }
  .skill-card { min-width:0; padding:19px 17px; border:1px solid var(--line); border-radius:13px; background:var(--soft); }
  .skill-card-heading { display:flex; align-items:center; gap:10px; min-height:36px; }
  .skill-icon { display:grid; place-items:center; flex:0 0 33px; width:33px; height:33px; border:1px solid var(--line); border-radius:10px; background:var(--surface); color:var(--green); }
  .skill-card h3 { color:var(--ink); font-size:13px; line-height:1.5; font-weight:500; letter-spacing:-.01em; }
  .skill-card ul { display:grid; gap:9px; list-style:none; margin:17px 0 0; padding:0; }
  .skill-card li { display:flex; align-items:baseline; gap:8px; color:var(--muted); font-size:12px; line-height:1.6; text-wrap:pretty; }
  .skill-dot { flex:0 0 3px; width:3px; height:3px; border-radius:50%; background:var(--subtle); transform:translateY(-3px); }
  .skill-card .sft-item { color:var(--ink); }
  .sft-item .skill-dot { background:var(--green); }
  @media(max-width:1000px) { .skills-cards { grid-template-columns:repeat(2,minmax(0,1fr)); } .skill-card { padding:18px; } .skill-card ul { margin-top:13px; } .skill-card li { font-size:13px; } }
  @media(max-width:700px) { .research-skills { padding:25px; } .skills-heading { display:block; } .skills-heading > p { margin-top:10px; max-width:46ch; } .desktop-break { display:none; } }
  @media(max-width:520px) { .research-skills { padding:23px 20px; border-radius:19px; } .skills-cards { grid-template-columns:minmax(0,1fr); gap:11px; margin-top:20px; } .skill-card { padding:16px; } .skill-card h3 { font-size:14px; } .skill-card ul { margin:12px 0 0 43px; gap:6px; } }
</style>
