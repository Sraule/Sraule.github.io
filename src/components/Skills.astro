---
import { skills } from '../data/profile';
---
<section id="skills" class="shell research-skills" aria-labelledby="skills-heading">
  <h2 id="skills-heading">Skills</h2>
  <div class="skills-copy">
    <ul class="skills-tools" aria-label="Programming tools">{skills.tools.map(tool => <li>{tool}</li>)}</ul>
    <p>{skills.summary}</p>
  </div>
</section>
<style>
  .research-skills { display:grid; grid-template-columns:160px minmax(0,1fr); align-items:start; gap:40px; margin-top:50px; padding-block:30px 5px; border-top:1px solid var(--rule); }
  h2 { font:400 40px/1.2 var(--font-display); letter-spacing:-.025em; }
  .skills-copy { max-width:700px; padding-top:4px; }
  .skills-tools { display:flex; flex-wrap:wrap; gap:12px; align-items:baseline; font:400 25px/1.4 var(--font-display); }
  .skills-tools li + li::before { content:'·'; margin-right:12px; color:var(--accent); }
  .skills-copy p { max-width:76ch; margin-top:12px; color:var(--muted); font-size:14px; line-height:1.85; text-wrap:pretty; }
  @media(max-width:800px) { .research-skills { grid-template-columns:130px minmax(0,1fr); gap:25px; } }
  @media(max-width:560px) { .research-skills { grid-template-columns:1fr; gap:18px; margin-top:38px; padding-top:26px; } h2 { font-size:33px; } .skills-copy { padding-top:0; } .skills-tools { font-size:24px; } .skills-copy p { margin-top:10px; font-size:13px; } }
</style>
