---
import { lemonStudy } from '../data/lemon';
import PaperFigure from './PaperFigure.astro';
const { tasks, evaluation } = lemonStudy;
---
<div class="lemon-study">
  <section class="study-section" aria-labelledby="lemon-task-design">
    <header class="study-heading"><p class="study-label">02 / Task design</p><h4 id="lemon-task-design">{tasks.title}</h4><p>{tasks.intro}</p></header>
    <div class="task-layout">
      <PaperFigure image={tasks.image} alt={tasks.alt} caption={tasks.caption} label="LEMON Figure 3" width={1988} height={1320}/>
      <dl class="task-list">{tasks.items.map((task, index) => <div><dt><span aria-hidden="true">{String(index+1).padStart(2, '0')}</span>{task.name}</dt><dd>{task.description}</dd></div>)}</dl>
    </div>
  </section>
  <section class="study-section" aria-labelledby="lemon-evaluation">
    <header class="study-heading"><p class="study-label">03 / Evaluation &amp; findings</p><h4 id="lemon-evaluation">{evaluation.title}</h4><p>{evaluation.intro}</p></header>
    <div class="results-layout">
      <PaperFigure image={evaluation.image} alt={evaluation.alt} caption={evaluation.caption} label="LEMON Figure 4b" width={1660} height={610}/>
      <div class="finding-list">{evaluation.findings.map(finding => <div><h5>{finding.title}</h5><p>{finding.description}</p></div>)}</div>
    </div>
    <div class="ablation-heading"><h5>{evaluation.ablationTitle}</h5><p>{evaluation.ablationIntro}</p></div>
    <div class="ablation-grid">{evaluation.ablations.map(ablation => <section class="ablation-card" aria-label={`${ablation.title} ablation results`}>
      <div class="ablation-title"><h6>{ablation.title}</h6><span>{ablation.source}</span></div><p>{ablation.description}</p>
      <div class="table-scroll"><table><caption class="sr-only">{ablation.title}: video-only accuracy compared with {ablation.input}; changes in percentage points.</caption><thead><tr><th scope="col">Model</th><th scope="col">Video</th><th scope="col"><span class="sr-only">{ablation.input}</span><span aria-hidden="true">{ablation.inputLabel}</span></th><th scope="col">Δ (pp)</th></tr></thead><tbody>{ablation.rows.map(row => <tr><th scope="row">{row.model}</th><td>{row.baseline}</td><td>{row.augmented}</td><td class:list={[row.positive ? 'gain' : 'drop']}>{row.delta}</td></tr>)}</tbody></table></div>
    </section>)}</div>
  </section>
</div>
<style>
  .study-section { margin-top:30px; padding-top:26px; border-top:1px solid var(--line); }
  .study-label { color:var(--green); font-size:11px; font-weight:600; line-height:1.5; letter-spacing:.085em; text-transform:uppercase; }
  .study-heading h4 { margin-top:8px; color:var(--ink); font-size:21px; font-weight:500; line-height:1.35; letter-spacing:-.025em; text-wrap:pretty; }
  .study-heading > p:last-child { max-width:100ch; margin-top:9px; color:var(--muted); font-size:13px; line-height:1.8; text-wrap:pretty; }
  .task-layout { display:grid; grid-template-columns:minmax(0,1.5fr) minmax(0,1fr); gap:26px; align-items:start; margin-top:21px; }
  .task-list { margin:0; padding:0; display:grid; gap:12px; }
  .task-list dt { display:flex; align-items:baseline; gap:9px; color:var(--ink); font-size:13px; font-weight:500; line-height:1.5; }
  .task-list dt span { color:var(--subtle); font-size:10px; font-weight:400; font-variant-numeric:tabular-nums; }
  .task-list dd { margin:3px 0 0 23px; color:var(--muted); font-size:12px; line-height:1.7; text-wrap:pretty; }
  .results-layout { display:grid; grid-template-columns:minmax(0,1.75fr) minmax(0,1fr); align-items:start; gap:26px; margin-top:21px; }
  .finding-list { display:grid; gap:16px; }
  .finding-list h5,.ablation-heading h5 { color:var(--ink); font-size:14px; font-weight:500; line-height:1.6; letter-spacing:-.01em; }
  .finding-list p { margin-top:5px; color:var(--muted); font-size:12px; line-height:1.8; text-wrap:pretty; }
  .ablation-heading { margin-top:24px; }
  .ablation-heading p { max-width:110ch; margin-top:5px; color:var(--muted); font-size:12px; line-height:1.8; }
  .ablation-grid { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:16px; margin-top:14px; }
  .ablation-card { min-width:0; padding:17px 18px; border:1px solid var(--line); border-radius:12px; background:var(--soft); }
  .ablation-title { display:flex; align-items:baseline; justify-content:space-between; gap:15px; }
  .ablation-title h6 { color:var(--ink); font-size:13px; font-weight:500; line-height:1.5; }
  .ablation-title > span { color:var(--subtle); font-size:10px; white-space:nowrap; }
  .ablation-card > p { margin-top:5px; color:var(--muted); font-size:12px; line-height:1.65; }
  .table-scroll { overflow-x:auto; margin-top:13px; }
  table { width:100%; border-collapse:collapse; font-size:11px; line-height:1.6; font-variant-numeric:tabular-nums; }
  th,td { padding:8px 0 8px 10px; text-align:right; white-space:nowrap; border-top:1px solid var(--line); }
  th:first-child { padding-left:0; text-align:left; }
  thead th { color:var(--subtle); font-size:10px; font-weight:400; }
  tbody th { color:var(--ink); font-weight:400; }
  tbody td { color:var(--muted); }
  .gain { color:var(--green); font-weight:500; }
  .drop { color:var(--ink); font-weight:500; }
  @media(max-width:1000px) {
    .task-layout { gap:22px; grid-template-columns:minmax(0,1.25fr) minmax(0,1fr); }
    .results-layout { gap:22px; grid-template-columns:minmax(0,1.5fr) minmax(0,1fr); }
    .ablation-card { padding:15px 13px; }
    table { font-size:10px; }
    th,td { padding-left:7px; }
  }
  @media(max-width:760px) {
    .task-layout,.results-layout { grid-template-columns:minmax(0,1fr); gap:20px; }
    .task-list { grid-template-columns:repeat(2,minmax(0,1fr)); gap:18px; }
    .task-list dd { font-size:13px; }
    .finding-list { grid-template-columns:repeat(2,minmax(0,1fr)); gap:20px; }
    .finding-list p,.ablation-heading p,.ablation-card > p { font-size:13px; }
    .study-heading > p:last-child { font-size:14px; }
    .ablation-grid { grid-template-columns:minmax(0,1fr); }
    .ablation-card { padding:17px; }
    table { font-size:12px; }
  }
  @media(max-width:520px) {
    .study-section { margin-top:25px; padding-top:22px; }
    .study-heading h4 { font-size:20px; }
    .task-list,.finding-list { grid-template-columns:minmax(0,1fr); gap:15px; }
    .task-list dt,.finding-list h5 { font-size:14px; }
    .ablation-card { padding:14px 12px; }
    table { font-size:10.5px; }
    th,td { padding-left:7px; }
  }
</style>
